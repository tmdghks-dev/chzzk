{
  "name": "chzzk-desktop",
  "productName": "Chzzk",
  "version": "1.2.0",
  "description": "치지직 데스크톱 앱 (chzzk.tmdghks.dev)",
  "main": "main.js",
  "author": "tmdghks",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.tmdghks.chzzk",
    "artifactName": "chzzk-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "NSCameraUsageDescription": "라이브 방송을 송출할 때 카메라를 사용해요.",
        "NSMicrophoneUsageDescription": "라이브 방송을 송출할 때 마이크를 사용해요.",
        "CFBundleDisplayName": "치지직"
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true
    }
  }
}
